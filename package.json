{
  "name": "pagefault",
  "version": "0.1.0",
  "private": true,
  "description": "PAGEFAULT.DEV - interactive OS / computer-systems learning laboratory. Today: the UI-independent simulation engine.",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.cli.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "engine:build": "tsc -p tsconfig.cli.json",
    "demo": "npm run engine:build && node .engine-build/scripts/demo.js"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}